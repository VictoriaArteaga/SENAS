# Copiar a `.env` (ignorado por Git) y reemplazar los valores. Este archivo solo
# contiene marcadores de posición: NUNCA guardar contraseñas ni secretos reales en Git.
#
# El formato definitivo de usuario/host (conexión directa o pooler Supavisor, p. ej.
# `senas_app.<project_ref>`) se confirmará cuando se creen los roles en Supabase.

# --- Ejecución de NestJS (Prisma Client) --------------------------------------
# Rol `senas_app`: privilegios mínimos, sin DDL ni BYPASSRLS.
# Es la ÚNICA variable de base de datos que lee la aplicación en ejecución.
DATABASE_URL=postgresql://senas_app:CHANGE_ME@HOST:PORT/DATABASE

# --- Migraciones (Prisma CLI) --------------------------------------------------
# Rol `senas_migrator`: propietario de las tablas. Se usa EXCLUSIVAMENTE con Prisma CLI
# (`npm run prisma:migrate:deploy`). Prisma CLI no usa DATABASE_URL como alternativa.
# NO definir esta variable en el entorno de producción de NestJS (con NODE_ENV=production
# la API se niega a arrancar si existe): debe existir solo donde se ejecutan las migraciones
# (máquina del administrador o job de despliegue).
# Para migraciones usar conexión directa o pooler en modo sesión, no modo transacción.
MIGRATION_DATABASE_URL=postgresql://senas_migrator:CHANGE_ME@HOST:PORT/DATABASE

# --- Autenticación (access token JWT) -----------------------------------------
# Clave de firma HS256. OBLIGATORIA: la API no arranca si falta, tiene menos de 32 caracteres
# o parece un valor de ejemplo. Genérala con un generador criptográfico, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Usa una distinta por entorno y no la compartas ni la subas a Git.
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_WITH_32_OR_MORE_CHARS
# Vigencia del access token (formato <número><s|m|h|d>, máximo 1h). Por defecto 15m.
JWT_ACCESS_EXPIRES_IN=15m
# Vigencia del refresh token / sesión (máximo 90d, mayor que la del access token). Por defecto 30d.
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Rate limiting de autenticación (por IP y por ruta, en memoria) --------------------
# Ventana en segundos y máximo de intentos por ventana. Todos opcionales (enteros 1 a 1000000).
# Solo afectan a /auth/login, /auth/register y /auth/refresh. Con varias instancias de la API cada
# una cuenta por separado (ver README). Detrás de un proxy hay que configurar `trust proxy`.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30

# --- Servidor ---------------------------------------------------------------------
# NODE_ENV: development | production | test (por defecto development)
NODE_ENV=development
PORT=3000
